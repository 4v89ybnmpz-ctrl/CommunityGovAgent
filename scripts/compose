#!/usr/bin/env bash
# 用唯一的 webhook/runtime/.env 调用 Docker Compose。不要在仓库根目录另建 .env。
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
ENV_FILE="$ROOT/issue-gov-agent/.env"

if [[ ! -f "$ENV_FILE" ]]; then
  echo "缺少 issue-gov-agent/.env。请先在 issue-gov-agent 目录执行 manage.py init。" >&2
  exit 1
fi

cd "$ROOT"
exec docker compose --env-file "$ENV_FILE" "$@"
